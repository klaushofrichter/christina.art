{
  "name": "christina-art",
  "private": true,
  "description": "Website for the artist Christina Schwarz, served at christinaschwarz.art by Express on Knative/k3s.",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsx scripts/build-content.ts",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "images": "tsx scripts/images.ts",
    "sheet": "tsx scripts/sheet-to-json.ts",
    "sheet:csv": "tsx scripts/json-to-sheet-csv.ts"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26",
    "@types/supertest": "^7.2.1",
    "sharp": "^0.35.5",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
